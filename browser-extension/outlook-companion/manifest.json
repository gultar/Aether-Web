{
  "manifest_version": 3,
  "name": "BrowserOS Outlook Companion",
  "version": "1.0.0",
  "description": "Lets BrowserOS save pre-filled Outlook Web calendar events in your normal signed-in browser session.",
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://outlook.live.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "browseros-heartbeat.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://outlook.live.com/*"
      ],
      "js": [
        "outlook-compose.js"
      ],
      "run_at": "document_start"
    }
  ]
}
